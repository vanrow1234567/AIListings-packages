{
  "name": "ailistings-visibility-audit",
  "version": "0.1.0",
  "private": true,
  "description": "AIListings autonomous AI visibility lead audit MVP (Visible / Recommended / Conversational) measured against the consumer ChatGPT website.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "build": "tsc",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:browser": "node --test 'test/browser/**/*.test.ts'",
    "start": "node --no-warnings src/server.ts",
    "start:dist": "node dist/server.js",
    "connect": "node --no-warnings src/cli.ts connect",
    "audit": "node --no-warnings src/cli.ts audit",
    "reanalyse": "node --no-warnings src/cli.ts reanalyse"
  },
  "dependencies": {
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
